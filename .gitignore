# ===== Build outputs (generated by build.ps1) =====
build/
*.exe
*.zip
SnapCut-*.exe
SnapCut-*.zip

# ===== Large binaries / ML models =====
# These are downloaded at build- or run-time, never committed.
# See README.md ("Binary assets") and plugins/MODEL_GUIDE.md.
*.onnx
onnxruntime*.dll
plugins/ffmpeg/*.exe

# ===== Media / local data (never source) =====
videos/
update/*
!update/manifest.txt
*.mp4

# ===== Third-party reference source (not part of the product) =====
reference/

# ===== IDE / OS =====
.vs/
*.suo
*.user
*.sln.docstates
Thumbs.db
.DS_Store
